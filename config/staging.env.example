# TEMPLATE ONLY. Set privately in the dedicated Preview environment. Never reuse .env.local.
CLINAHIR_ENV=staging
VITE_APP_ENV=staging
CLINAHIR_STAGING_ORIGIN=
CLINAHIR_STAGING_SUPABASE_REF=
CLINAHIR_PRODUCTION_SUPABASE_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLINAHIR_ADMIN_EMAIL=
CLINAHIR_ADMIN_USER_ID=
CLINAHIR_ADMIN_MFA_REQUIRED=true
CRON_SECRET=
DAILY_COMMAND_URL=
CLINAHIR_STAGING_CRM_ORIGIN=
CLINAHIR_PRODUCTION_CRM_ORIGIN=
# Set false only after the owner confirms no production CRM exists; then leave its origin empty.
CLINAHIR_PRODUCTION_CRM_CONFIGURED=
CLINAHIR_INTEGRATION_SECRET=
# Separate receiver hosting access, server-only; never reuse its token for another origin.
STAGING_CRM_PROTECTION_BYPASS=
WHATSAPP_ENABLED=false
# No Meta credentials in staging. Hosted access protection is configured separately by the owner.
# Optional, reviewed error-only telemetry. Disabled by default.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
