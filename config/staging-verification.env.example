# Private operator template only. Never load production .env.local.
CLINAHIR_ENV=staging
WHATSAPP_ENABLED=false
CLINAHIR_STAGING_ORIGIN=
CLINAHIR_STAGING_SUPABASE_REF=
CLINAHIR_PRODUCTION_SUPABASE_REF=
SUPABASE_URL=
# Independently obtained public/publishable key, never a service-role key.
SUPABASE_ANON_KEY=
STAGING_OWNER_ID=
STAGING_OWNER_EMAIL=
STAGING_OWNER_PASSWORD=
STAGING_NONOWNER_ID=
STAGING_NONOWNER_EMAIL=
STAGING_NONOWNER_PASSWORD=
# Optional server-side automation bypass for the protected preview. Never put in a URL.
STAGING_PROTECTION_BYPASS=
# Leave blank until the owner explicitly approves the precise action.
# Access-only value: synthetic-staging-auth-only (creates/revokes test auth sessions).
STAGING_VERIFICATION_APPROVED=
# Additional business-write value: synthetic-staging-business-writes.
STAGING_WORKFLOW_APPROVED=
CLINAHIR_STAGING_CRM_ORIGIN=
CLINAHIR_PRODUCTION_CRM_ORIGIN=
DAILY_COMMAND_URL=
CLINAHIR_INTEGRATION_SECRET=
