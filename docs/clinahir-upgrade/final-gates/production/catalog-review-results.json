    "constraints": [
      {
        "entity": "clinahir_analytics_events",
        "conname": "clinahir_analytics_events_event_type_check",
        "definition": "CHECK ((event_type = ANY (ARRAY['page_view'::text, 'demo_cta_click'::text])))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_analytics_events",
        "conname": "clinahir_analytics_events_language_check",
        "definition": "CHECK ((language = ANY (ARRAY['en'::text, 'fr'::text])))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_analytics_events",
        "conname": "clinahir_analytics_events_pkey",
        "definition": "PRIMARY KEY (id)",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_analytics_events",
        "conname": "clinahir_analytics_events_placement_check",
        "definition": "CHECK ((placement = ANY (ARRAY['page'::text, 'hero'::text, 'solutions'::text, 'how-it-works'::text, 'process'::text, 'about'::text, 'book-demo'::text, 'footer'::text, 'other'::text])))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_lead_limits",
        "conname": "clinahir_lead_limits_identifier_check",
        "definition": "CHECK ((identifier ~ '^[0-9a-f]{64}$'::text))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_lead_limits",
        "conname": "clinahir_lead_limits_pkey",
        "definition": "PRIMARY KEY (identifier)",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_lead_limits",
        "conname": "clinahir_lead_limits_requests_check",
        "definition": "CHECK ((requests > 0))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_leads",
        "conname": "clinahir_company_name_not_blank",
        "definition": "CHECK (((length(TRIM(BOTH FROM company_name)) >= 1) AND (length(TRIM(BOTH FROM company_name)) <= 200)))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_leads",
        "conname": "clinahir_email_not_blank",
        "definition": "CHECK (((length(TRIM(BOTH FROM email)) >= 3) AND (length(TRIM(BOTH FROM email)) <= 254)))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_leads",
        "conname": "clinahir_external_id_format",
        "definition": "CHECK ((external_id ~~ 'cli_%'::text))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_leads",
        "conname": "clinahir_fingerprint_format",
        "definition": "CHECK (((submission_fingerprint IS NULL) OR (submission_fingerprint ~ '^[0-9a-f]{64}$'::text)))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_leads",
        "conname": "clinahir_leads_daily_command_attempts_check",
        "definition": "CHECK ((daily_command_attempts >= 0))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_leads",
        "conname": "clinahir_leads_daily_command_status_check",
        "definition": "CHECK ((daily_command_status = ANY (ARRAY['pending'::text, 'synced'::text, 'blocked'::text, 'exhausted'::text])))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_leads",
        "conname": "clinahir_leads_external_id_key",
        "definition": "UNIQUE (external_id)",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_leads",
        "conname": "clinahir_leads_form_type_check",
        "definition": "CHECK ((form_type = ANY (ARRAY['demo'::text, 'contact'::text, 'consultation'::text, 'booking'::text])))",
        "schema_name": "public"
      },
      {
        "entity": "clinahir_leads",
        "conname": "clinahir_leads_pkey",
        "definition": "PRIMARY KEY (id)",
