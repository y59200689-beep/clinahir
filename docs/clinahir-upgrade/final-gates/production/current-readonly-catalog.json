        "relrowsecurity": false,
        "view_definition": " WITH events AS (\n         SELECT (clinahir_analytics_events.created_at AT TIME ZONE 'Africa/Casablanca'::text)::date AS day,\n            count(*) FILTER (WHERE clinahir_analytics_events.event_type = 'page_view'::text) AS page_views,\n            count(*) FILTER (WHERE clinahir_analytics_events.event_type = 'demo_cta_click'::text) AS demo_cta_clicks\n           FROM clinahir_analytics_events\n          GROUP BY ((clinahir_analytics_events.created_at AT TIME ZONE 'Africa/Casablanca'::text)::date)\n        ), leads AS (\n         SELECT (clinahir_leads.submitted_at AT TIME ZONE 'Africa/Casablanca'::text)::date AS day,\n            count(*) AS demo_submissions\n           FROM clinahir_leads\n          WHERE clinahir_leads.form_type = 'demo'::text\n          GROUP BY ((clinahir_leads.submitted_at AT TIME ZONE 'Africa/Casablanca'::text)::date)\n        )\n SELECT COALESCE(e.day, l.day) AS day,\n    COALESCE(e.page_views, 0::bigint) AS page_views,\n    COALESCE(e.demo_cta_clicks, 0::bigint) AS demo_cta_clicks,\n    COALESCE(l.demo_submissions, 0::bigint) AS demo_submissions\n   FROM events e\n     FULL JOIN leads l ON e.day = l.day;",
        "relforcerowsecurity": false
      },
