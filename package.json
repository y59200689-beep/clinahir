    "postcss": "^8.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
